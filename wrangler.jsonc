{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pablo-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pablo-releases",
      "database_id": "ecac5cf0-05f0-421a-b441-e8774c389a49"
    }
  ],
  "observability": {
    "enabled": true
  }
}
