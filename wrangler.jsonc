{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pablo-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pablo-releases",
      "database_id": "7f3a1c2e-5b6d-4e8f-9a0b-1c2d3e4f5a6b"
    }
  ],
  "observability": {
    "enabled": true
  }
}
